<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Python Notes</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #0f172a;
    color: #e2e8f0;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
  }
  .container {
    width: 100%;
    max-width: 800px;
  }
  h1 {
    font-size: 1.8rem;
    margin: 0 0 8px;
    color: #38bdf8;
  }
  p.sub {
    margin: 0 0 24px;
    color: #94a3b8;
    font-size: 0.95rem;
  }
  textarea {
    width: 100%;
    height: 400px;
    padding: 16px;
    font-family: "SF Mono", Consolas, Monaco, monospace;
    font-size: 14px;
    line-height: 1.5;
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 8px;
    resize: vertical;
    outline: none;
  }
  textarea:focus {
    border-color: #38bdf8;
  }
  .controls {
    margin-top: 16px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  button {
    padding: 10px 20px;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s;
  }
  #downloadBtn {
    background: #38bdf8;
    color: #0f172a;
  }
  #downloadBtn:hover {
    background: #7dd3fc;
  }
  #clearBtn {
    background: #334155;
    color: #e2e8f0;
  }
  #clearBtn:hover {
    background: #475569;
  }
  input[type="text"] {
    padding: 10px 12px;
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.95rem;
    outline: none;
  }
  input[type="text"]:focus {
    border-color: #38bdf8;
  }
</style>
</head>
<body>
  <div class="container">
    <h1>Python Notes</h1>
    <p class="sub">Write anything below, then download it as a .py file.</p>

    <textarea id="codeBox" placeholder="# Write your Python code or notes here...
def hello():
    print('Hello, world!')

hello()"></textarea>

    <div class="controls">
      <input type="text" id="filename" value="my_script" placeholder="filename">
      <button id="downloadBtn">Download as .py</button>
      <button id="clearBtn">Clear</button>
    </div>
  </div>

<script>
  const codeBox   = document.getElementById('codeBox');
  const filename  = document.getElementById('filename');
  const downloadBtn = document.getElementById('downloadBtn');
  const clearBtn  = document.getElementById('clearBtn');

  // Load any saved text on page open
  codeBox.value = localStorage.getItem('pyNotes') || '';

  // Save as you type
  codeBox.addEventListener('input', () => {
    localStorage.setItem('pyNotes', codeBox.value);
  });

  downloadBtn.addEventListener('click', () => {
    const text = codeBox.value;
    if (!text.trim()) {
      alert('Nothing to download — the text area is empty.');
      return;
    }

    let name = (filename.value || 'my_script').trim().replace(/\.py$/i, '');
    if (!name) name = 'my_script';

    const blob = new Blob([text], { type: 'text/x-python;charset=utf-8' });
    const url  = URL.createObjectURL(blob);

    const a = document.createElement('a');
    a.href = url;
    a.download = name + '.py';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  clearBtn.addEventListener('click', () => {
    if (confirm('Clear everything?')) {
      codeBox.value = '';
      localStorage.removeItem('pyNotes');
    }
  });
</script>
</body>
</html> 
